{
	email {$ACME_EMAIL}
	admin off
	log default {
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
			}
		}
	}
}

{$SITE_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	basic_auth {
		import /run/secrets/team_users
	}
	reverse_proxy backend:8090 {
		header_up -Authorization
		header_up X-Team-User {http.auth.user.id}
		header_up X-Team-Gateway {$GATEWAY_SECRET}
		transport http {
			dial_timeout 5s
			response_header_timeout 130s
		}
	}
}
