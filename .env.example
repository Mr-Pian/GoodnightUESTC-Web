# Full external HTTPS origin, including a nonstandard port when used.
# No path, trailing slash, query, or credentials.
PUBLIC_ORIGIN=https://checkin.example.com
# Only published on 127.0.0.1; your existing proxy connects here.
BACKEND_PORT=18090
# Internal proxy-to-backend secret, never a user login password.
# Generate: python -c 'import secrets; print(secrets.token_hex(32))'
GATEWAY_SECRET=
# Recommended installation uses Tianditu and requires your own key.
# Run: python3 deploy/install.py (interactive; asks for the key without echo).
# Advanced manual setups may select auto or osm; see deploy/README.md.
MAP_PROVIDER=tianditu
# Your own browser-visible Tianditu map-service key. Restrict its allowed sites
# and quota in the provider console. Never use a school or gateway credential here.
TIANDITU_KEY=
# Tag each release explicitly; retain the previous image for rollback.
BACKEND_IMAGE=goodnightuestc-web:local
# Optional build-only base image override (use a trusted Python 3.12 Debian Bookworm image).
# PYTHON_IMAGE=python:3.12-slim-bookworm
SESSION_IDLE_SECONDS=1800
SESSION_LIFETIME_SECONDS=28800
# Absolute lifetime of a remembered login; polling and restoration do not renew it.
SESSION_PACKAGE_TTL_SECONDS=604800
MAX_SAVED_DEVICES=1024
MAX_SESSIONS=64
MAX_SESSIONS_PER_BROWSER=8
MAX_CONCURRENT_LOGINS=2
# Per-source-IP budgets = per-browser budgets times this number (shared NAT).
SOURCE_RATE_MULTIPLIER=4
