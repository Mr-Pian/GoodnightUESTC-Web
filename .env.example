# Public DNS name only: no scheme, path, or trailing slash.
SITE_DOMAIN=checkin.example.com
ACME_EMAIL=admin@example.com
# Generate: python -c 'import secrets; print(secrets.token_hex(32))'
GATEWAY_SECRET=
# Tag each release explicitly; retain the previous image for rollback.
BACKEND_IMAGE=goodnightuestc-web:local
SESSION_IDLE_SECONDS=1800
SESSION_LIFETIME_SECONDS=28800
# Absolute lifetime of a remembered login; polling and restoration do not renew it.
SESSION_PACKAGE_TTL_SECONDS=604800
MAX_SAVED_DEVICES=1024
MAX_SAVED_DEVICES_PER_USER=8
MAX_SESSIONS=64
MAX_SESSIONS_PER_USER=8
MAX_CONCURRENT_LOGINS=2
